+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync,rmSync } from 'node:fs';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import { validateAction,desktopState,setDesktopEnabled,runDesktop } from '../server/agent/desktop-control.mjs';
+import { manualDecision,planDecision } from '../server/agent/plugins/strata-gate.mjs';
+test('desktop permission gate only exempts exact read tools',()=>{
+ for(const name of ['desktop_windows','desktop_inspect','desktop_screenshot']){
+  assert.equal(manualDecision({name:`mcp__desktop__${name}`}),null);
+  assert.equal(planDecision({name:`mcp__desktop__${name}`}),null);
+ }
+ for(const action of ['click','type','key','focus','move','invoke']){
+  const e={name:'mcp__desktop__desktop_act',arguments:{action,windowId:'123'}};
+  assert.equal(manualDecision(e).kind,'ask');assert.equal(planDecision(e).kind,'deny');
+ }
+ assert.equal(planDecision({name:'mcp__desktop__desktop_screenshot_fake'}).kind,'deny');
+});
+test('desktop validates identity, bounded input and key chords',()=>{
+ const target={windowId:'123',pid:123};
+ assert.throws(()=>validateAction({action:'click'}));
+ assert.throws(()=>validateAction({...target,action:'type',text:'x'.repeat(513)}));
+ assert.throws(()=>validateAction({...target,action:'key',key:'{RUN evil}'}));
+ assert.throws(()=>validateAction({...target,action:'move',x:0,y:0,width:-1,height:100}));
+ assert.throws(()=>validateAction({...target,action:'click',x:NaN,y:0}));
+ assert.equal(validateAction({...target,action:'key',key:'CTRL+A'}).key,'CTRL+A');
+});
+test('stop is persistent and a resume rotates the generation',async()=>{
+ const dir=mkdtempSync(join(tmpdir(),'desktop-test-'));
+ try{assert.equal(desktopState(dir).enabled,false);const a=setDesktopEnabled(dir,true);const b=setDesktopEnabled(dir,false);const c=setDesktopEnabled(dir,true);assert.notEqual(a.epoch,b.epoch);assert.notEqual(a.epoch,c.epoch);setDesktopEnabled(dir,false);await assert.rejects(runDesktop(dir,{action:'windows'}));}finally{rmSync(dir,{recursive:true,force:true});}
+});
