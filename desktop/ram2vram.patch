+++ b/apps/host/server/agent/desktop-control.ps1
@@ -0,0 +1,112 @@
+$ErrorActionPreference = 'Stop'
+[Console]::InputEncoding = New-Object System.Text.UTF8Encoding($false)
+[Console]::OutputEncoding = New-Object System.Text.UTF8Encoding($false)
+$request = [Console]::In.ReadToEnd() | ConvertFrom-Json
+$mutex = New-Object System.Threading.Mutex($false, 'Local\RAM2VRAM.Desktop.Control')
+$held = $false
+try {
+  try { $held = $mutex.WaitOne(0) } catch [System.Threading.AbandonedMutexException] { $held = $true }
+  if (!$held) { throw 'Screen is busy with another agent. Inspect again after that action finishes.' }
+  Add-Type -Path (Join-Path $PSScriptRoot 'desktop-native.cs')
+  Add-Type -AssemblyName UIAutomationClient,UIAutomationTypes,UIAutomationClientsideProviders,System.Drawing,System.Windows.Forms
+  [void][RDesktop]::SetProcessDpiAwarenessContext([IntPtr](-4))
+  function Check-Stop {
+    $s = Get-Content -LiteralPath $request.stateFile -Raw -Encoding UTF8 | ConvertFrom-Json
+    if (!$s.enabled -or $s.epoch -ne $request.epoch) { throw 'Screen control was stopped. Enable it again in the app before a new action.' }
+    if (([RDesktop]::GetAsyncKeyState(0x1B) -band 0x8000) -ne 0) { throw 'Escape is held; screen action cancelled.' }
+  }
+  Check-Stop
+  if ($request.action -eq 'windows') {
+    $rows = New-Object System.Collections.Generic.List[object]
+    $callback = [RDesktop+EnumProc] { param($handle,$unused)
+      if ([RDesktop]::IsWindowVisible($handle)) {
+        $title = [RDesktop]::Title($handle)
+        if ($title) { $rect=[RDesktop]::Bounds($handle);$rows.Add(@{windowId=$handle.ToInt64().ToString();pid=[RDesktop]::Pid($handle);title=$title;minimized=[RDesktop]::IsIconic($handle);bounds=@{x=$rect.Left;y=$rect.Top;width=$rect.Right-$rect.Left;height=$rect.Bottom-$rect.Top}}) }
+      }; return $true
+    }
+    [void][RDesktop]::EnumWindows($callback,[IntPtr]::Zero)
+    @{windows=@($rows.ToArray());coordinates='physical pixels'} | ConvertTo-Json -Depth 8 -Compress
+  } else {
+    $handle=[IntPtr]([long]$request.windowId)
+    if (![RDesktop]::IsWindowVisible($handle) -or [RDesktop]::Pid($handle) -ne $request.pid) { throw 'Window identity changed; list windows again.' }
+    $rect=[RDesktop]::Bounds($handle)
+    function Check-Focus {
+      Check-Stop
+      if ([RDesktop]::GetForegroundWindow() -ne $handle) { throw 'Target lost foreground focus; no input sent. Inspect and focus the intended window again.' }
+      if ([RDesktop]::Pid($handle) -ne $request.pid) { throw 'Window identity changed.' }
+    }
+    $result=@{windowId=$request.windowId;pid=$request.pid;action=$request.action;bounds=@{x=$rect.Left;y=$rect.Top;width=$rect.Right-$rect.Left;height=$rect.Bottom-$rect.Top}}
+    if ($request.action -in 'click','drag','scroll','type','key','invoke') {Check-Stop;[RDesktop]::Focus($handle);Start-Sleep -Milliseconds 100;Check-Focus;$rect=[RDesktop]::Bounds($handle)}
+    switch ($request.action) {
+      'inspect' {
+        $root=[System.Windows.Automation.AutomationElement]::FromHandle($handle)
+        $walker=[System.Windows.Automation.TreeWalker]::ControlViewWalker
+        $queue=New-Object System.Collections.Generic.Queue[object];$queue.Enqueue($root)
+        $rows=New-Object System.Collections.Generic.List[object]
+        while ($queue.Count -gt 0 -and $rows.Count -lt 150) {
+          Check-Stop;$el=$queue.Dequeue()
+          try {
+            $c=$el.Current;$b=$c.BoundingRectangle
+            if (!$c.IsPassword) {
+              $row=@{elementId=($el.GetRuntimeId() -join '.');name=$c.Name;type=$c.ControlType.ProgrammaticName;enabled=$c.IsEnabled;offscreen=$c.IsOffscreen;bounds=@{x=$b.X-$rect.Left;y=$b.Y-$rect.Top;width=$b.Width;height=$b.Height}}
+              $pattern=$null
+              if ($el.TryGetCurrentPattern([System.Windows.Automation.ValuePattern]::Pattern,[ref]$pattern)) { $v=$pattern.Current.Value;if($v.Length -gt 2000){$v=$v.Substring(0,2000)};$row.value=$v }
+              $rows.Add($row)
+            }
+            $child=$walker.GetFirstChild($el);$n=0
+            while ($null -ne $child -and $n -lt 150 -and $queue.Count -lt 300) {$queue.Enqueue($child);$child=$walker.GetNextSibling($child);$n++}
+          } catch { }
+        }
+        $result.elements=@($rows.ToArray());$result.truncated=($queue.Count -gt 0)
+      }
+      'screenshot' {
+        if ([RDesktop]::IsIconic($handle)) { throw 'Restore the minimized window before capture.' }
+        $screen=[System.Windows.Forms.SystemInformation]::VirtualScreen
+        $left=[Math]::Max($rect.Left,$screen.Left);$top=[Math]::Max($rect.Top,$screen.Top)
+        $w=[Math]::Min($rect.Right,$screen.Right)-$left;$height=[Math]::Min($rect.Bottom,$screen.Bottom)-$top
+        if ($w -le 0 -or $height -le 0 -or $w*$height -gt 24000000) { throw 'Window capture size is unsupported.' }
+        $bitmap=New-Object System.Drawing.Bitmap($w,$height);$g=[System.Drawing.Graphics]::FromImage($bitmap);$stream=New-Object System.IO.MemoryStream
+        try {$g.CopyFromScreen($left,$top,0,0,$bitmap.Size);$bitmap.Save($stream,[System.Drawing.Imaging.ImageFormat]::Png);$result.image=[Convert]::ToBase64String($stream.ToArray());$result.capture=@{x=$left;y=$top;width=$w;height=$height};$result.note='Visible screen region; overlapping windows are included. Coordinates use original physical pixels.'} finally {$g.Dispose();$bitmap.Dispose();$stream.Dispose()}
+      }
+      'focus' {[RDesktop]::Focus($handle);Start-Sleep -Milliseconds 100;Check-Focus}
+      'restore' {[void][RDesktop]::ShowWindow($handle,9)}
+      'minimize' {[void][RDesktop]::ShowWindow($handle,6)}
+      'move' {if(![RDesktop]::MoveWindow($handle,$request.x,$request.y,$request.width,$request.height,$true)){throw 'Window move failed.'}}
+      {$_ -in 'click','drag','scroll'} {
+        Check-Focus
+        if ($request.x -lt 0 -or $request.y -lt 0 -or $request.x -ge ($rect.Right-$rect.Left) -or $request.y -ge ($rect.Bottom-$rect.Top)) { throw 'Point lies outside the target window.' }
+        $point=New-Object RDesktop+Point(($rect.Left+$request.x),($rect.Top+$request.y))
+        if ([RDesktop]::GetAncestor([RDesktop]::WindowFromPoint($point),2) -ne $handle) { throw 'Another window covers the target point; no click sent.' }
+        [void][RDesktop]::SetCursorPos($point.X,$point.Y);Check-Focus
+        if ($request.action -eq 'click') {[RDesktop]::Click($request.button -eq 'right')}
+        elseif($request.action -eq 'drag') {
+          if($request.endX -ge ($rect.Right-$rect.Left) -or $request.endY -ge ($rect.Bottom-$rect.Top)){throw 'Drag endpoint outside target window.'}
+          $endPoint=New-Object RDesktop+Point(($rect.Left+$request.endX),($rect.Top+$request.endY))
+          if([RDesktop]::GetAncestor([RDesktop]::WindowFromPoint($endPoint),2) -ne $handle){throw 'Drag endpoint is covered by another window.'}
+          [RDesktop]::LeftButton($true)
+          try {for($step=1;$step -le 12;$step++){Check-Focus;[void][RDesktop]::SetCursorPos([int]($point.X+($endPoint.X-$point.X)*$step/12),[int]($point.Y+($endPoint.Y-$point.Y)*$step/12));Start-Sleep -Milliseconds 15}}finally{[RDesktop]::LeftButton($false)}
+        }else{[RDesktop]::Scroll($request.steps)}
+      }
+      'type' {foreach($character in $request.text.ToCharArray()){Check-Focus;[RDesktop]::Character($character)}}
+      'key' {
+        Check-Focus
+        $map=@{CTRL=17;ALT=18;SHIFT=16;ENTER=13;TAB=9;ESC=27;BACKSPACE=8;DELETE=46;HOME=36;END=35;LEFT=37;RIGHT=39;UP=38;DOWN=40;SPACE=32}
+        $keys=@();foreach($part in $request.key.Split('+')){if($map.ContainsKey($part)){$keys+=[uint16]$map[$part]}elseif($part -match '^F(\d+)$'){$keys+=[uint16](111+[int]$Matches[1])}else{$keys+=[uint16][char]$part}}
+        [RDesktop]::Chord([uint16[]]$keys)
+      }
+      'invoke' {
+        Check-Focus
+        $root=[System.Windows.Automation.AutomationElement]::FromHandle($handle)
+        $found=$null;$all=$root.FindAll([System.Windows.Automation.TreeScope]::Descendants,[System.Windows.Automation.Condition]::TrueCondition)
+        for($i=0;$i -lt [Math]::Min($all.Count,2000);$i++){if(($all[$i].GetRuntimeId() -join '.') -eq $request.elementId){$found=$all[$i];break}}
+        if($null -eq $found -or !$found.Current.IsEnabled -or $found.Current.IsOffscreen -or $found.Current.IsPassword){throw 'Element is stale or unavailable; inspect again.'}
+        $pattern=$null
+        if(!$found.TryGetCurrentPattern([System.Windows.Automation.InvokePattern]::Pattern,[ref]$pattern)){throw 'Element does not support Invoke; use an observed click target.'}
+        Check-Focus;$pattern.Invoke()
+      }
+      default {throw 'Unknown action'}
+    }
+    Check-Stop;$result | ConvertTo-Json -Depth 10 -Compress
+  }
+} catch { @{error=$_.Exception.Message} | ConvertTo-Json -Compress }
+finally {if($held){$mutex.ReleaseMutex()};$mutex.Dispose()}
