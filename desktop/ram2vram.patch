@@ -0,0 +1,27 @@
+export const defaults = Object.freeze({ temperature: 0.6, top_p: 0.95, top_k: 40, max_tokens: 4096, korean: true, logit_bias: {} });
+export function validateGeneration(value) {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('설정은 객체여야 합니다.');
+  const result = { ...defaults, ...value };
+  for (const key of Object.keys(value)) if (!(key in defaults)) throw new Error(`알 수 없는 설정: ${key}`);
+  for (const [key, min, max, integer] of [['temperature',0,2,false],['top_p',0.001,1,false],['top_k',1,64,true],['max_tokens',1,32768,true]]) {
+    const n = result[key];
+    if (!Number.isFinite(n) || n < min || n > max || (integer && !Number.isInteger(n))) throw new Error(`${key}: ${min}~${max} 범위${integer ? '의 정수' : ''}를 입력하세요.`);
+  }
+  if (typeof result.korean !== 'boolean') throw new Error('한국어 설정은 true/false여야 합니다.');
+  const bias = result.logit_bias;
+  if (!bias || typeof bias !== 'object' || Array.isArray(bias) || Object.keys(bias).length > 1024) throw new Error('Logit Bias는 최대 1024개의 토큰 ID 객체여야 합니다.');
+  for (const [id,n] of Object.entries(bias)) if (!/^(0|[1-9]\d*)$/.test(id) || !Number.isSafeInteger(Number(id)) || !Number.isFinite(n) || n < -100 || n > 100) throw new Error('Logit Bias: 토큰 ID는 음이 아닌 정수, 값은 -100~100이어야 합니다.');
+  return result;
+}
+export function generationSampling(value) {
+  if (!value) return null;
+  const { korean, logit_bias, ...sampling } = validateGeneration(value);
+  return { ...sampling, workspace_settings: true, ...(Object.keys(logit_bias).length ? {logit_bias} : {}), ...(korean ? {workspace_language: true} : {}) };
+}
+export function applyGeneration(body, sampling) {
+  if (!sampling?.workspace_settings) return body;
+  const { workspace_language, workspace_settings, ...fields } = sampling;
+  const result = { ...body, ...fields };
+  if (workspace_language && Array.isArray(body.messages)) result.messages = [{role:'system',content:'사용자에게 보여 주는 설명과 최종 답변은 자연스러운 한국어로 작성하세요. 사용자가 다른 언어를 명시적으로 요청하면 그 요청을 따르세요. 코드, 파일 경로, URL, 고유명사와 원문 인용은 정확하게 유지하세요. 도구 이름과 인수 형식은 바꾸지 마세요.'}, ...body.messages];
+  return result;
+}
