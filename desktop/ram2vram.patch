+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync,mkdirSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { startScriptedWorker } from './helpers/scripted-worker.mjs';
+import { createAgentBridge } from '../server/agent/agent-bridge.mjs';
+import { createAgentTools } from '../server/agent/tools-settings.mjs';
+
+test('real Harness offers desktop MCP, Plan denies actions, Manual asks, Bypass reaches disabled latch', {skip:!process.env.STRATA_HARNESS_DIR},async t=>{
+ const dir=mkdtempSync(join(tmpdir(),'desktop-harness-'));const ws=join(dir,'ws');mkdirSync(ws);
+ const worker=await startScriptedWorker({});const tools=createAgentTools({dataDir:dir,read:()=>({}),write:()=>{}});tools.ensureFile();
+ const bridge=createAgentBridge({dataDir:dir,localInstances:()=>[{id:'fixture',baseUrl:worker.url,modelId:'scripted-model',context:32768}],connections:()=>[],tools:()=>tools.profileView(),env:process.env});
+ t.after(async()=>{await bridge.close();await worker.close();});
+ const run=async(mode,tool,args)=>{const frames=[];await bridge.runTurn({chatId:`desktop-${mode}-${tool}`,mode,workspacePath:ws,message:`SCRIPT:call ${tool} ${JSON.stringify(args)}`,onFrame:f=>{frames.push(f);if(f.type==='agent-tool'&&f.tool.state==='proposed')void bridge.approve({chatId:`desktop-${mode}-${tool}`,callId:f.tool.id,decision:'deny'});}});return frames;};
+ const args={action:'focus',windowId:'1',pid:1},name='mcp__desktop__desktop_act';
+ const plan=await run('plan',name,args);assert.ok(plan.some(f=>f.tool?.state==='error'&&/Plan mode only looks/.test(f.tool.result)));assert.ok(!plan.some(f=>f.tool?.state==='proposed'));
+ const manual=await run('manual',name,args);assert.ok(manual.some(f=>f.tool?.state==='proposed'));
+ const bypass=await run('bypass',name,args);assert.ok(!bypass.some(f=>f.tool?.state==='proposed'));assert.match(JSON.stringify(bypass),/화면 제어가 중지/);
+ const read=await run('plan','mcp__desktop__desktop_windows',{});assert.ok(!read.some(f=>f.tool?.state==='proposed'));assert.match(JSON.stringify(read),/화면 제어가 중지/);
+});
