@@ -0,0 +1,29 @@
+import { createInterface } from 'node:readline';
+import { runDesktop } from './desktop-control.mjs';
+const [dir,vision]=process.argv.slice(2);
+const target={windowId:{type:'string',description:'Window handle from desktop_windows'},pid:{type:'integer'}};
+const schema=(properties,required=[])=>({type:'object',properties,required,additionalProperties:false});
+const definitions=[
+ {name:'desktop_windows',description:'List visible Windows windows. Ask the person to enable screen control in the app if disabled.',inputSchema:schema({}),annotations:{readOnlyHint:true}},
+ {name:'desktop_inspect',description:'Read up to 150 UI Automation elements in a window. Prefer elementId and invoke for buttons. Password values are excluded.',inputSchema:schema(target,['windowId','pid']),annotations:{readOnlyHint:true}},
+ {name:'desktop_screenshot',description:'Capture the visible window region without focusing it. Other overlapping windows may appear. Returns PNG only on an image-capable route; text-only routes should use desktop_inspect. Never infer unseen coordinates.',inputSchema:schema(target,['windowId','pid']),annotations:{readOnlyHint:true}},
+ {name:'desktop_act',description:'One Windows action, serialized across agents. First inspect/list the target. Input actions activate the target then verify focus before sending input. Coordinates are physical pixels relative to the outer window top-left; move uses absolute screen coordinates. Re-inspect after each action. No arbitrary code. If busy or focus changed, inspect again instead of retrying blindly.',inputSchema:schema({...target,action:{type:'string',enum:['focus','move','minimize','restore','click','drag','scroll','type','key','invoke']},x:{type:'integer'},y:{type:'integer'},endX:{type:'integer'},endY:{type:'integer'},width:{type:'integer'},height:{type:'integer'},steps:{type:'integer',minimum:-10,maximum:10},button:{type:'string',enum:['left','right']},text:{type:'string',maxLength:512},key:{type:'string',description:'For example CTRL+A, ENTER, ALT+TAB'},elementId:{type:'string'}},['windowId','pid','action']),annotations:{readOnlyHint:false}}
+];
+const send=(id,result,error)=>process.stdout.write(JSON.stringify({jsonrpc:'2.0',id,...(error?{error}:{result})})+'\n');
+createInterface({input:process.stdin}).on('line',async line=>{
+ let m;try{m=JSON.parse(line);}catch{return;}if(m.id===undefined)return;
+ try{
+  if(m.method==='initialize')return send(m.id,{protocolVersion:m.params?.protocolVersion??'2024-11-05',capabilities:{tools:{}},serverInfo:{name:'ram2vram-desktop',version:'1.0.0'}});
+  if(m.method==='ping')return send(m.id,{});
+  if(m.method==='tools/list')return send(m.id,{tools:definitions});
+  if(m.method!=='tools/call')return send(m.id,null,{code:-32601,message:'Unknown method'});
+  const name=m.params?.name;if(!definitions.some(t=>t.name===name))throw new Error('Unknown tool');
+  const args=m.params.arguments??{};
+  const action=name==='desktop_act'?args.action:name.replace('desktop_','');
+  if(name==='desktop_act'&&['windows','inspect','screenshot'].includes(action))throw new Error('Use a read tool');
+  const r=await runDesktop(dir,{...args,action});const {image,...info}=r;
+  const content=[{type:'text',text:JSON.stringify({...info,...(image&&vision!=='vision'?{notice:'This model route is text-only. Use desktop_inspect; screenshot pixels are not sent to the model.'}:{})})}];
+  if(image&&vision==='vision')content.push({type:'image',mimeType:'image/png',data:image});
+  send(m.id,{content});
+ }catch(e){send(m.id,{isError:true,content:[{type:'text',text:e.message}]});}
+});
