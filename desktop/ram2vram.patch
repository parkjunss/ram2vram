diff --git a/apps/desktop/src-tauri/src/ram2vram.rs b/apps/desktop/src-tauri/src/ram2vram.rs
new file mode 100644
index 0000000..2b36844
--- /dev/null
+++ b/apps/desktop/src-tauri/src/ram2vram.rs
@@ -0,0 +1,30 @@
+//! Application identity and state boundary for the RAM2VRAM fork.
+use std::path::PathBuf;
+
+pub fn configure() {
+    // A portable build carries only a workspace pointer, never settings or keys.
+    if let Some(root) = std::env::current_exe().ok().and_then(|exe| {
+        let text = std::fs::read_to_string(exe.parent()?.join("ram2vram.json")).ok()?;
+        let value: serde_json::Value = serde_json::from_str(&text).ok()?;
+        let root = PathBuf::from(value.get("workspaceRoot")?.as_str()?);
+        (root.is_absolute() && root.is_dir()).then_some(root)
+    }) {
+        if std::env::var_os("STRATA_DESKTOP_DATA_DIR").is_none() {
+            std::env::set_var("STRATA_DESKTOP_DATA_DIR", root.join(".ram2vram-desktop"));
+        }
+        std::env::set_var("STRATA_WORKSPACE", &root);
+        std::env::set_var("STRATA_MODELS_DIR", root.join("models/qwen38"));
+    }
+    let base = std::env::var_os("STRATA_DESKTOP_DATA_DIR").map(PathBuf::from)
+        .unwrap_or_else(|| std::env::var_os("LOCALAPPDATA").map(PathBuf::from)
+            .unwrap_or_else(std::env::temp_dir).join("RAM2VRAM"));
+    for (key, suffix) in [
+        ("STRATA_HOME", ""), ("STRATA_DESKTOP_DATA_DIR", ""),
+        ("STRATA_SETTINGS_FILE", "app-settings.json"),
+        ("STRATA_COMPONENTS_DIR", "components"), ("STRATA_PROFILE_DIR", "profiles"),
+        ("STRATA_RUNTIME_DIR", "runtime"), ("STRATA_TUNE_DIR", "tuning"),
+        ("STRATA_TIMESKIP_DIR", "time-skip"),
+    ] {
+        std::env::set_var(key, base.join(suffix));
+    }
+}
