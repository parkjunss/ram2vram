new file mode 100644
index 0000000..29e7fd8
--- /dev/null
+++ b/apps/host/server/agent/desktop-control.mjs
@@ -0,0 +1,55 @@
+import { spawn } from 'node:child_process';
+import { mkdirSync, readFileSync, writeFileSync, renameSync } from 'node:fs';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { randomUUID } from 'node:crypto';
+
+export const looking = new Set(['windows', 'inspect', 'screenshot']);
+const actions = new Set([...looking, 'focus', 'move', 'minimize', 'restore', 'click', 'drag', 'scroll', 'type', 'key', 'invoke']);
+export const statePath = dir => join(dir, 'desktop-control.json');
+export function desktopState(dir) {
+  try { const s=JSON.parse(readFileSync(statePath(dir),'utf8')); return {supported:process.platform==='win32',enabled:s.enabled===true,epoch:s.epoch}; }
+  catch { return {supported:process.platform==='win32',enabled:false,epoch:''}; }
+}
+export function setDesktopEnabled(dir, enabled) {
+  mkdirSync(dir,{recursive:true});const file=statePath(dir),tmp=`${file}.${randomUUID()}.tmp`;
+  writeFileSync(tmp,JSON.stringify({enabled:enabled===true,epoch:randomUUID()}));renameSync(tmp,file);
+  return desktopState(dir);
+}
+export function validateAction(input) {
+  if(!input || !actions.has(input.action))throw new Error('Unknown desktop action');
+  const b={...input};
+  if(b.action!=='windows'){
+    if(!/^\d{1,16}$/.test(String(b.windowId)) || !Number.isSafeInteger(b.pid) || b.pid<1)throw new Error('Use windowId and pid returned by windows');
+  }
+  const int=(key,min,max)=>{if(!Number.isInteger(b[key])||b[key]<min||b[key]>max)throw new Error(`Invalid ${key}`);};
+  if(['click','drag','scroll','move'].includes(b.action)){int('x',-32768,32767);int('y',-32768,32767);}
+  if(b.action==='drag'){int('endX',0,32767);int('endY',0,32767);}
+  if(b.action==='move'){int('width',100,16000);int('height',100,16000);}
+  if(b.action==='scroll')int('steps',-10,10);
+  if(b.action==='click'&&!['left','right'].includes(b.button??'left'))throw new Error('Invalid mouse button');
+  if(b.action==='type'&&(typeof b.text!=='string'||b.text.length>512||b.text.length<1))throw new Error('Text must contain 1–512 characters');
+  if(b.action==='key'&&!/^(?:(?:CTRL|ALT|SHIFT)\+){0,3}(?:[A-Z0-9]|ENTER|TAB|ESC|BACKSPACE|DELETE|HOME|END|LEFT|RIGHT|UP|DOWN|SPACE|F(?:[1-9]|1[0-2]))$/.test(b.key??''))throw new Error('Unsupported key chord');
+  if(b.action==='invoke'&&!/^-?\d+(?:\.-?\d+){1,15}$/.test(b.elementId??''))throw new Error('Use an elementId from inspect');
+  return b;
+}
+export async function runDesktop(dir,input,{timeout=20000}={}) {
+  const b=validateAction(input),s=desktopState(dir);
+  if(!s.supported)throw new Error('Desktop tools require Windows');
+  if(!s.enabled)throw new Error('화면 제어가 중지되어 있습니다. 앱에서 화면 제어 허용을 눌러 주세요.');
+  return new Promise((resolve,reject)=>{
+    const p=spawn('powershell.exe',['-NoLogo','-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-File',fileURLToPath(new URL('./desktop-control.ps1',import.meta.url))],{windowsHide:true,stdio:['pipe','pipe','pipe']});
+    let out='',err='',settled=false;
+    const finish=(error,value)=>{if(settled)return;settled=true;clearTimeout(timer);error?reject(error):resolve(value);};
+    const timer=setTimeout(()=>{
+      // Give a bounded input loop time to observe cancellation and release a dragged button before terminating a stuck UIA call.
+      try{setDesktopEnabled(dir,false);}catch{}
+      setTimeout(()=>{p.kill();finish(new Error('Desktop tool timed out. Screen control was stopped; inspect the window before enabling it again.'));},1000);
+    },timeout);
+    p.stdout.setEncoding('utf8');p.stderr.setEncoding('utf8');
+    p.stdout.on('data',c=>{out+=c;if(out.length>16*1024*1024){p.kill();finish(new Error('Desktop result too large'));}});
+    p.stderr.on('data',c=>err=(err+c).slice(-4000));p.on('error',e=>finish(e));
+    p.on('close',code=>{try {if(code)throw new Error(err||'Desktop helper failed');const r=JSON.parse(out.replace(/^\uFEFF/,''));if(r.error)throw new Error(r.error);finish(null,r);}catch(e){finish(e);}});
+    p.stdin.on('error',()=>{});p.stdin.end(JSON.stringify({...b,stateFile:statePath(dir),epoch:s.epoch}));
+  });
+}
