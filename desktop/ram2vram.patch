+import { compactionHeadroom, localOutputBudget } from './agent/profile.mjs';
+
+export function contextTokens(args = []) {
+  let found = null;
+  for (let i = 0; i < args.length; i++) {
+    if (args[i] === '--max-context') found = Number(args[++i]);
+    else if (args[i].startsWith('--max-context=')) found = Number(args[i].split('=')[1]);
+  }
+  return Number.isInteger(found) && found > 0 ? found : null;
+}
+export function withContext(args, tokens) {
+  if (!Number.isInteger(tokens) || tokens < 16384 || tokens > 131072 || tokens % 1024) throw new Error('컨텍스트는 16384~131072 범위에서 1024 단위로 입력하세요.');
+  const next = [];
+  for (let i = 0; i < args.length; i++) {
+    if (args[i] === '--max-context') { i++; continue; }
+    if (!args[i].startsWith('--max-context=')) next.push(args[i]);
+  }
+  return [...next, '--max-context', String(tokens)];
+}
+export function compactionInfo(window) {
+  if (!(window > 0)) return { enabled: true, triggerTokens: null };
+  const reply = localOutputBudget(window);
+  return { enabled: true, triggerTokens: Math.floor(Math.min(window * 0.8, window - reply - compactionHeadroom(window, reply))) };
+}
